# ============================================================
# dw-ecom 环境变量模板
# 用法：cp .env.example .env  然后填入真实值；启动脚本会自动 source
# 也可以直接在 systemd 的 EnvironmentFile= 里引用本文件
# ============================================================

# --- Oracle 时空 ERP（必填）---
ORACLE_PASSWORD=在这里填Oracle密码

# --- MySQL（仅当启用 MySQL->DuckDB 每日镜像时需要；否则可留空）---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=在这里填MySQL密码

# --- DuckDB / MCP 可选覆盖 ---
# DUCKDB_PATH=/opt/dw-ecom/data/duckdb/ecom.duckdb
# ECOM_WRITE_LOCK=/tmp/ecom_duckdb_write.lock
# MCP_API_KEY=在这里填一个足够随机的Key
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
