[Unit]
Description=dw-ecom Streamlit dashboard
After=network-online.target dw-ecom-cdc-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/.venv/bin/streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=10
StandardOutput=append:__INSTALL_DIR__/logs/streamlit.log
StandardError=append:__INSTALL_DIR__/logs/streamlit.log

[Install]
WantedBy=multi-user.target
