<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.dw-ecom.mcp-http</string>
    <key>ProgramArguments</key>
    <array>
        <string>__INSTALL_DIR__/.venv/bin/python</string>
        <string>src/server_http.py</string>
    </array>
    <key>WorkingDirectory</key><string>__INSTALL_DIR__/duckdb-mcp-server</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key><string>__HOME__</string>
        <key>MCP_HOST</key><string>0.0.0.0</string>
        <key>MCP_PORT</key><string>8765</string>
        <key>PATH</key><string>__INSTALL_DIR__/.venv/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>__INSTALL_DIR__/logs/mcp-http.log</string>
    <key>StandardErrorPath</key><string>__INSTALL_DIR__/logs/mcp-http.log</string>
</dict>
</plist>
